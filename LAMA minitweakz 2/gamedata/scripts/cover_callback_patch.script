-- cover_callback_patch.script
-- FIX: original valid_npc() blocked ANY non-alive object including items,
-- smart terrains, and server entities passed as 2nd arg to SendScriptCallback.
-- This broke callbacks like server_entity_on_register, npc_on_eval_danger, etc.
--
-- New logic: pass through if obj:alive() errors (not a creature),
-- block only if confirmed dead.

local original_SendScriptCallback = SendScriptCallback

local function is_confirmed_dead(obj)
    if obj == nil then return false end
    if type(obj) ~= "userdata" then return false end
    -- Try alive(). If it errors, obj is not a creature → don't block.
    local ok, alive = pcall(function() return obj:alive() end)
    if not ok then return false end  -- not a creature type, pass through
    return not alive                  -- block only confirmed-dead creatures
end

function SendScriptCallback(name, obj, ...)
    if is_confirmed_dead(obj) then
        return
    end
    if original_SendScriptCallback then
        original_SendScriptCallback(name, obj, ...)
    end
end
