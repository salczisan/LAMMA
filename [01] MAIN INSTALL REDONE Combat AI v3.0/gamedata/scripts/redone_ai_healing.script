--[[
	scheme_type: generic
	author: eAkman
--]]

-- Generic panic scheme for healing states

actid = 188190
evaid = 188190
-------------------------------
local db = db
local time_global = time_global
local math_random = math.random
local math_min = math.min
local math_max = math.max
-------------------------------
local HEALTH_THRESHOLD = 0.75
local HEAL_AMOUNT = 0.35
local HEAL_DURATION_MS = 3500
local SAFE_TIME_MS = 3000
local MIN_ENEMY_DIST = 8
local CHARGE_KEY = "healing_charge"
local CHARGE_INIT_KEY = "healing_charge_init_version"
local CHARGE_INIT_VERSION = 1
local HEAL_STATE = "redone_combat_heal"
local INJECTOR_SECTION = "redone_ai_injector"

local initialized = false

local function ai_medkit_enabled()
	return stealth_mcm.get_config("enable_ai_medkit")
end

local function debug_medkit_enabled()
	return stealth_mcm.get_config("debug_medkit")
end

local function debug_print(fmt, ...)
	if not debug_medkit_enabled() then
		return
	end

	printf("[Combat AI][HEALING] " .. fmt, ...)
end

local function fmt_num(value)
	return string.format("%.2f", tonumber(value) or 0)
end

local function clear_safe_window(st)
	if not st then return end
	st.heal_safe_since = nil
	st.heal_safe_enemy_id = nil
	st.heal_safe_logged = nil
end

local function set_interrupt_reason(st, reason)
	if st then
		st.heal_interrupt_reason = reason
	end
end

local function is_blocked_npc(npc)
	if not npc or not npc:alive() then
		return true
	end

	if npc:section() == "actor_visual_stalker" then
		return true
	end

	local community = npc:character_community()
	if community == "zombied" or community == "trader" then
		return true
	end

	if npc:has_info("npcx_is_companion") then
		return true
	end

	return false
end

local function get_charge_count(npc)
	local value = se_load_var(npc:id(), npc:name(), CHARGE_KEY)

	-- Compatibility with previous RE:DONE saves where healing_charge was boolean.
	if value == true then
		return 1
	end

	return math_max(0, tonumber(value) or 0)
end

local function has_charge(npc)
	return get_charge_count(npc) > 0
end

local function get_rank_charge_count(npc)
	local rank = ranks.get_obj_rank_name(npc) or "experienced"
	local count = 1

	if rank == "expert"
	or rank == "master"
	or rank == "legend" then
		count = 3
	elseif rank == "experienced"
	or rank == "professional"
	or rank == "veteran" then
		count = 2
	end

	return count, rank
end

local function initialize_healing_charges(npc)
	local init_value = se_load_var(npc:id(), npc:name(), CHARGE_INIT_KEY)
	local init_version = tonumber(init_value) or 0
	if init_version >= CHARGE_INIT_VERSION then
		return
	end

	local count = 0
	local rank = ranks.get_obj_rank_name(npc) or "experienced"

	-- Preserve an already existing charge from an older save.
	-- NPCs with no remaining charge are rolled once for this new initialization version.
	local old_value = se_load_var(npc:id(), npc:name(), CHARGE_KEY)
	if old_value ~= nil then
		count = old_value == true and 1 or math_max(0, tonumber(old_value) or 0)

		if count > 0 then
			se_save_var(npc:id(), npc:name(), CHARGE_KEY, count)
		end
	elseif math_random() > 0.2 then
		count, rank = get_rank_charge_count(npc)
		se_save_var(npc:id(), npc:name(), CHARGE_KEY, count)
	end

	se_save_var(npc:id(), npc:name(), CHARGE_INIT_KEY, CHARGE_INIT_VERSION)

	debug_print(
		"CHARGES npc=[%s] id=[%s] rank=[%s] charges=[%s] init=[%s]",
		npc:name(),
		npc:id(),
		tostring(rank),
		count,
		CHARGE_INIT_VERSION
	)
end

local function consume_charge(npc)
	local before = get_charge_count(npc)
	local after = math_max(0, before - 1)

	if after > 0 then
		se_save_var(npc:id(), npc:name(), CHARGE_KEY, after)
	else
		se_save_var(npc:id(), npc:name(), CHARGE_KEY, nil)
	end

	return before, after
end

local function cleanup_injector(npc)
	if not npc then
		return
	end

	local item = npc:object(INJECTOR_SECTION)
	if not item then
		return
	end

	item:enable_attachable_item(false)

	local sim = alife()
	if sim and sim:object(item:id()) then
		alife_release_id(item:id())
	end
end

-------------------------------------------------------------------------------------
-- STATE MANAGER CLEANUP
-------------------------------------------------------------------------------------
local function reset_state_manager_after_healing(npc)
	if not npc then
		return
	end

	local storage = db.storage[npc:id()]
	local manager = storage and storage.state_mgr

	npc:clear_animations()

	if manager then
		manager:set_state("idle", nil, nil, nil, {fast_set = true})

		if manager.animation then
			manager.animation:set_state(nil, true)
			manager.animation:set_control()
		end
	end
end

local function panic_active(npc)
	local storage = db.storage[npc:id()]
	return storage and (
		storage.aoe_panic == true
		or storage.panicked == true
	)
end

-- Healing safety is directional in both ways:
-- 1) the NPC must not currently see the enemy
-- 2) the enemy must not currently see the NPC
--
-- The second check is important when the NPC has turned away from the enemy:
-- npc:see(enemy) may be false while the NPC is still completely exposed.
local function get_combat_visibility(npc, enemy)
	if not (npc and enemy and enemy:alive()) then
		return false, false
	end

	local npc_see_enemy = npc:see(enemy) == true
	local enemy_see_npc = enemy:see(npc) == true

	return npc_see_enemy, enemy_see_npc
end

-- Public priority/reservation query used by other generic combat schemes.
-- Healing reserves the NPC as soon as the continuous WAIT-SAFE window begins,
-- not only after the healing action has initialized.
function is_healing_reserved(npc)
	if not npc then
		return false
	end

	local storage = db.storage[npc:id()]
	local st = storage and storage.redone_ai_healing

	return st and (
		st.healing_active == true
		or st.heal_safe_since ~= nil
	) or false
end

-------------------------------------------------------------------------------------
-- HEALING EVALUATOR
-------------------------------------------------------------------------------------
class "evaluator_redone_ai_healing" (property_evaluator)

function evaluator_redone_ai_healing:__init(npc, name, storage) super(nil, name)
	self.st = storage
end

function evaluator_redone_ai_healing:evaluate()
	local npc = self.object
	local st = self.st

	-- APPLY is the terminal point of this healing action. Force the evaluator
	-- false immediately so GOAP finalizes the action, releases movement and
	-- resets state_mgr. Without this, an NPC that is still below the heal
	-- threshold after one medkit (for example 0.31 -> 0.66) can keep this
	-- action selected indefinitely while execute() does nothing.
	if st.heal_applied then
		return false
	end

	if not ai_medkit_enabled() then
		if st.healing_active then
			set_interrupt_reason(st, "MCM_DISABLED")
		end
		clear_safe_window(st)
		return false
	end

	if is_blocked_npc(npc) then
		clear_safe_window(st)
		return false
	end

	-- Wounded owns its own planner/action and must always win.
	if IsWounded(npc) then
		if st.healing_active then
			set_interrupt_reason(st, "WOUNDED")
		end
		clear_safe_window(st)
		return false
	end

	-- Flee/panic always has priority over healing. This also means a NPC that
	-- has already started fleeing will never stop just because a heal is available.
	if panic_active(npc) then
		if st.healing_active then
			set_interrupt_reason(st, "FLEE")
		end
		clear_safe_window(st)
		return false
	end

	-- Combat healing only: use the same selected target as the rest of Combat AI.
	-- get_combat_enemy() still requires a valid engine best_enemy(), so this does
	-- not create or prolong combat on its own.
	local enemy = redone_ai_combat.get_combat_enemy(npc)
	if not (enemy and enemy:alive()) then
		if st.healing_active then
			set_interrupt_reason(st, "NO_ENEMY")
		end
		clear_safe_window(st)
		return false
	end

	local enemy_dist = npc:position():distance_to(enemy:position())

	local npc_see_enemy, enemy_see_npc = get_combat_visibility(npc, enemy)

	-- Once healing has started, either direction of LOS means the position is
	-- no longer safe. This catches the case where the NPC has its back turned
	-- but the enemy/player still has a clear view of the NPC.
	if st.healing_active then
		if enemy_see_npc then
			set_interrupt_reason(st, "ENEMY_SEES_NPC")
			clear_safe_window(st)
			return false
		end

		if npc_see_enemy then
			set_interrupt_reason(st, "NPC_SEES_ENEMY")
			clear_safe_window(st)
			return false
		end

		if enemy_dist < MIN_ENEMY_DIST then
			set_interrupt_reason(st, "ENEMY_CLOSE")
			clear_safe_window(st)
			return false
		end

		return true
	end

	if npc.health >= HEALTH_THRESHOLD then
		clear_safe_window(st)
		return false
	end

	if not has_charge(npc) then
		clear_safe_window(st)
		return false
	end

	-- A heal position is only safe when LOS is blocked in BOTH directions.
	-- This prevents an NPC from turning its back to the enemy and treating
	-- npc:see(enemy) == false as cover while the enemy still sees the NPC.
	if npc_see_enemy or enemy_see_npc then
		clear_safe_window(st)
		return false
	end

	-- Even without direct LOS in either direction, do not heal while the enemy is too close.
	if enemy_dist < MIN_ENEMY_DIST then
		clear_safe_window(st)
		return false
	end

	-- Require a continuous safe window. This intentionally gives the existing
	-- npc_on_update flee check (2 second cadence) a chance to trigger first.
	local enemy_id = enemy:id()
	local now = time_global()

	if st.heal_safe_enemy_id ~= enemy_id then
		st.heal_safe_enemy_id = enemy_id
		st.heal_safe_since = now
		st.heal_safe_logged = false
	elseif not st.heal_safe_since then
		st.heal_safe_since = now
		st.heal_safe_logged = false
	end

	local safe_elapsed = now - st.heal_safe_since

	if safe_elapsed < SAFE_TIME_MS then
		if debug_medkit_enabled() and not st.heal_safe_logged then
			st.heal_safe_logged = true
			debug_print(
				"WAIT-SAFE npc=[%s] id=[%s] hp=[%s] enemy_dist=[%s] wait=[%sms] npc_see=[%s] enemy_see_npc=[%s]",
				npc:name(),
				npc:id(),
				fmt_num(npc.health),
				fmt_num(enemy_dist),
				SAFE_TIME_MS,
				tostring(npc_see_enemy),
				tostring(enemy_see_npc)
			)
		end
		return false
	end

	return true
end

-------------------------------------------------------------------------------------
-- HEALING ACTION
-------------------------------------------------------------------------------------
class "action_redone_ai_healing" (action_base)

function action_redone_ai_healing:__init(npc, name, storage) super(nil, name)
	self.st = storage
end

function action_redone_ai_healing:initialize()
	action_base.initialize(self)

	local npc = self.object
	self.st.healing_active = true
	self.st.heal_applied = false
	self.st.heal_interrupt_reason = nil
	self.st.heal_end_time = time_global() + HEAL_DURATION_MS

	npc:set_desired_position()
	npc:set_desired_direction()

	state_mgr.set_state(
		npc,
		HEAL_STATE,
		nil,
		nil,
		nil,
		{fast_set = true, animation = true}
	)

	-- Keep the NPC stationary while the state manager owns the animation.
	npc:movement_enabled(false)

	debug_print(
		"START npc=[%s] id=[%s] health=[%s] charges=[%s]",
		npc:name(),
		npc:id(),
		fmt_num(npc.health),
		get_charge_count(npc)
	)
end

function action_redone_ai_healing:execute()
	action_base.execute(self)

	local npc = self.object
	if self.st.heal_applied then
		return
	end

	if time_global() < (self.st.heal_end_time or 0) then
		return
	end

	local before = npc.health
	local amount = math_min(HEAL_AMOUNT, 1 - before)
	local expected = math_min(1, before + amount)

	if amount > 0 then
		npc:change_health(amount)
	end

	local charges_before, charges_after = consume_charge(npc)

	self.st.heal_applied = true
	self.st.healing_active = false

	debug_print(
		"APPLY npc=[%s] id=[%s] health=[%s -> %s] charges=[%s -> %s]",
		npc:name(),
		npc:id(),
		fmt_num(before),
		fmt_num(expected),
		charges_before,
		charges_after
	)
end

function action_redone_ai_healing:finalize()
	local npc = self.object
	local interrupted = not self.st.heal_applied
	local interrupt_reason = self.st.heal_interrupt_reason

	self.st.healing_active = false
	self.st.heal_applied = false
	self.st.heal_interrupt_reason = nil
	self.st.heal_end_time = nil
	clear_safe_window(self.st)

	if npc then
		-- Do not only clear the visual animation here. The healing state was
		-- fast-set into state_mgr, so reset state_mgr itself the same way its
		-- stock state_mgr_to_idle action does.
		reset_state_manager_after_healing(npc)

		npc:movement_enabled(true)
		npc:set_desired_position()
		npc:set_desired_direction()
	end

	action_base.finalize(self)

	if npc then
		if interrupted then
			debug_print(
				"INTERRUPT npc=[%s] id=[%s] health=[%s] reason=[%s] charges=[%s]",
				npc:name(),
				npc:id(),
				fmt_num(npc.health),
				tostring(interrupt_reason or "PLANNER"),
				get_charge_count(npc)
			)
		else
			debug_print(
				"FINISH npc=[%s] id=[%s] health=[%s]",
				npc:name(),
				npc:id(),
				fmt_num(npc.health)
			)
		end
	end
end

-------------------------------------------------------------------------------------
-- GENERIC SCHEME BINDER
-------------------------------------------------------------------------------------
function setup_generic_scheme(npc, ini, scheme, section, stype, temp)
	xr_logic.assign_storage_and_bind(npc, ini, scheme, section, temp)
end

function add_to_binder(npc, ini, scheme, section, storage, temp)
	if not npc then
		return
	end

	local manager = npc:motivation_action_manager()
	if not manager then
		return
	end

	if is_blocked_npc(npc) then
		manager:add_evaluator(evaid, property_evaluator_const(false))
		temp.needs_configured = false
		return
	end

	initialize_healing_charges(npc)

	manager:add_evaluator(
		evaid,
		evaluator_redone_ai_healing(npc, "eva_redone_ai_healing", storage)
	)

	temp.action = action_redone_ai_healing(npc, "act_redone_ai_healing", storage)

	temp.action:add_precondition(world_property(stalker_ids.property_alive, true))
	temp.action:add_precondition(world_property(stalker_ids.property_enemy, true))
	temp.action:add_precondition(world_property(stalker_ids.property_anomaly, false))
	temp.action:add_precondition(world_property(evaid, true))

	temp.action:add_effect(world_property(evaid, false))

	manager:add_action(actid, temp.action)
end

-------------------------------------------------------------------------------------
-- CONFIGURE ACTIONS
-------------------------------------------------------------------------------------
function configure_actions(npc, ini, scheme, section, stype, temp)
	if not npc or not temp.action then
		return
	end

	local manager = npc:motivation_action_manager()
	if not manager then
		return
	end

	temp.action:add_precondition(world_property(xr_evaluators_id.sidor_wounded_base, false))
	temp.action:add_precondition(world_property(xr_evaluators_id.wounded_exist, false))

	-- AOE panic/flee has priority over healing.
	if demonized_stalker_aoe_panic and demonized_stalker_aoe_panic.evaid then
		temp.action:add_precondition(
			world_property(demonized_stalker_aoe_panic.evaid, false)
		)
	end

	local actions = {
		xr_danger.actid,
		stalker_ids.action_combat_planner,
		stalker_ids.action_danger_planner,
		xr_actions_id.state_mgr + 2,
		xr_actions_id.alife,

		-- RE:DONE scripted combat helpers. These are top-level planner actions,
		-- so they must also wait while the healing action owns the NPC.
		xr_actions_id.combat_camper_base + 0,
		xr_actions_id.combat_camper_base + 1,
		xr_actions_id.combat_monolith_base + 0,
		xr_actions_id.combat_monolith_base + 1,
		xr_actions_id.combat_monolith_base + 2,
		xr_actions_id.combat_monolith_base + 3,
	}

	for i = 1, #actions do
		local action = manager:action(actions[i])
		if action then
			action:add_precondition(world_property(evaid, false))
		end
	end
end

function disable_generic_scheme(npc, scheme, stype)
	local storage = db.storage[npc:id()][scheme]
	if storage then
		storage.enabled = false
		storage.healing_active = false
		storage.heal_interrupt_reason = nil
		clear_safe_window(storage)
	end
end

function npc_add_precondition(action)
	if action then
		action:add_precondition(world_property(evaid, false))
	end
end

-------------------------------------------------------------------------------------
-- VISUAL CLEANUP
-------------------------------------------------------------------------------------
local function npc_on_death_callback(npc)
	cleanup_injector(npc)
end

function on_game_start()
	if initialized then
		return
	end
	initialized = true

	if not (state_mgr_animation_list_ex and state_mgr_animation_list_ex.register_redone_animations) then
		abort("RE:DONE Combat AI: state_mgr_animation_list_ex.script is unavailable")
	end

	state_mgr_animation_list_ex.register_redone_animations()
	RegisterScriptCallback("npc_on_death_callback", npc_on_death_callback)

	debug_print(
		"TEST v4.4 loaded threshold=[%s] heal=[%s] duration=[%sms] safe_time=[%sms] min_enemy_dist=[%sm] charge_key=[%s]",
		fmt_num(HEALTH_THRESHOLD),
		fmt_num(HEAL_AMOUNT),
		HEAL_DURATION_MS,
		SAFE_TIME_MS,
		MIN_ENEMY_DIST,
		CHARGE_KEY
	)
end
