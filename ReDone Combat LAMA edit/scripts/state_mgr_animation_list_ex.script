--[[----------------------------------------------------------------------------------------------------------
	RE:DONE COMBAT AI - STATE MANAGER ANIMATION LIST EXTENSION
------------------------------------------------------------------------------------------------------------]]

local HEAL_ANIMATION = "redone_combat_heal"
local HEAL_STATE = "redone_combat_heal"
local INJECTOR_SECTION = "redone_ai_injector"
local INJURED_WALK_ANIMATION = "redone_injured_walk"
local INJURED_RUN_ANIMATION = "redone_injured_run"

local INJURED_ANIMATION_SLOTS = {
	[0] = true,
	[1] = true,
	[2] = true,
	[3] = true,
	[4] = true,
	[6] = true,
	[8] = true,
	[9] = true,
	[10] = true,
}

local initialized = false

local function build_injured_idle(suffix)
	local result = {}

	for slot in pairs(INJURED_ANIMATION_SLOTS) do
		result[slot] = string.format(
			"dmg_norm_torso_%s_%s_0",
			slot,
			suffix
		)
	end

	return result
end

function register_redone_animations()
	if initialized then
		return
	end
	initialized = true

	if not (state_mgr_animation_list and state_mgr_animation_list.animations) then
		abort("RE:DONE Combat AI: state_mgr_animation_list.animations is unavailable")
	end

	if not (state_lib and state_lib.states) then
		abort("RE:DONE Combat AI: state_lib.states is unavailable")
	end

	-- Combat healing animation/state.
	state_mgr_animation_list.animations[HEAL_ANIMATION] = {
		prop = {
			maxidle = 0,
			sumidle = 0,
			rnd = 100,
		},
		into = {
			[0] = {
				"dmg_norm_torso_11_draw_0",
				{a = INJECTOR_SECTION},
			},
		},
		out = {
			[0] = {
				"dmg_norm_torso_11_draw_0",
				{d = INJECTOR_SECTION},
			},
		},
		idle = {
			[0] = "dmg_norm_torso_11_attack_0",
		},
		rnd = nil,
	}

	state_lib.states[HEAL_STATE] = {
		weapon = "none",
		movement = move.stand,
		mental = anim.free,
		bodystate = move.standing,
		direction = look.cur_dir,
		animstate = nil,
		animation = HEAL_ANIMATION,
	}

	-- Injured locomotion animations. ;UNUSED
	state_mgr_animation_list.animations[INJURED_WALK_ANIMATION] = {
		prop = {
			maxidle = 0,
			sumidle = 1,
			rnd = 100,
		},
		into = nil,
		out = nil,
		idle = {
			[0] = "dmg_norm_walk_fwd_0",
		},
		rnd = nil,
	}

	state_mgr_animation_list.animations[INJURED_RUN_ANIMATION] = {
		prop = {
			maxidle = 0,
			sumidle = 0,
			rnd = 100,
			moving = true,
		},
		into = nil,
		out = nil,
		idle = build_injured_idle("run"),
		rnd = nil,
	}
end
