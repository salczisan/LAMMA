--[[----------------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------------------]]
local db = db
-------------------------------
local HEALTH_THRESHOLD = 0.75
local LOW_HEALTH_COMBAT_ENABLED = true
local hook_installed = false
local base_state_mgr_set_state = nil
local last_mapping = {}
local DEBUG = false
-------------------------------
local STATE_REMAP = {
	-- Low-health behavior is intentionally limited to movement-only states.
	-- Fire states must remain owned by the active combat action; remapping
	-- assault_fire/raid_fire here can fight GOAP/state_mgr after a hit and
	-- produce aim/facing jitter or apparent target loss.
	raid = "sneak",
	assault = "sneak_run",
}

local function fmt_num(value)
	return string.format("%.2f", tonumber(value) or 0)
end

local function debug_print(fmt, ...)
	if not DEBUG then
		return
	end

	printf("[Combat AI][LOW HEALTH] " .. fmt, ...)
end

local function is_blocked_npc(npc)
	if not npc or not npc:alive() then
		return true
	end

	if npc:section() == "actor_visual_stalker" then
		return true
	end

	local community = npc:character_community()
	if community == "zombied" or community == "trader" then
		return true
	end

	if npc:has_info("npcx_is_companion") then
		return true
	end

	return false
end

local function healing_active(npc)
	local storage = db.storage[npc:id()]
	local healing = storage and storage.redone_ai_healing
	return healing and healing.healing_active == true
end

local function priority_action_active(npc)
	local storage = db.storage[npc:id()]
	if not storage then
		return false
	end

	-- Panic/flee must own the NPC completely while active or reserved.
	if storage.aoe_panic == true
	or storage.panicked == true
	or storage.npc_panicked == true then
		return true
	end

	-- Healing reserves control before the animation itself starts.
	local healing = storage.redone_ai_healing
	if healing and (
		healing.healing_active == true
		or healing.heal_safe_since ~= nil
	) then
		return true
	end

	-- Do not rewrite combat locomotion while prone owns the action.
	local prone = storage.redone_ai_prone
	if prone and prone.prone_active == true then
		return true
	end

	-- Surrender/wounded logic has higher priority than low-health style.
	local surrender = storage.victim_surrender
	if type(surrender) == "number" and surrender >= 0 and surrender < 65534 then
		return true
	end

	return false
end

local function can_use_low_health_combat(npc)
	if not LOW_HEALTH_COMBAT_ENABLED or is_blocked_npc(npc) then
		return false
	end

	if npc.health >= HEALTH_THRESHOLD then
		return false
	end

	if IsWounded(npc) or healing_active(npc) or priority_action_active(npc) then
		return false
	end

	-- This file is only a modifier of an already-established combat state.
	-- It must never create or reshape behavior when the engine has no enemy.
	if not npc:best_enemy() then
		return false
	end

	return true
end

local function resolve_state(npc, state_name)
	if type(state_name) ~= "string" then
		return state_name
	end

	local target_state = STATE_REMAP[state_name]
	if not target_state then
		return state_name
	end

	if not can_use_low_health_combat(npc) then
		return state_name
	end

	local id = npc:id()

	if DEBUG and last_mapping[id] ~= target_state then
		last_mapping[id] = target_state

		debug_print(
			"REMAP npc=[%s] id=[%s] hp=[%s] state=[%s -> %s]",
			npc:name(),
			id,
			fmt_num(npc.health),
			state_name,
			target_state
		)
	end

	return target_state
end

local function install_state_mgr_hook()
	if hook_installed then
		return
	end

	if not (state_mgr and state_mgr.set_state) then
		abort("RE:DONE Combat AI: state_mgr.set_state is unavailable")
	end

	base_state_mgr_set_state = state_mgr.set_state

	state_mgr.set_state = function(npc, state_name, callback, timeout, target, extra)
		if npc and state_name then
			local requested_state = state_name
			local resolved_state = resolve_state(npc, requested_state)

			if DEBUG and resolved_state == requested_state then
				local id = npc:id()

				if last_mapping[id] then
					debug_print(
						"RELEASE npc=[%s] id=[%s] hp=[%s] requested=[%s]",
						npc:name(),
						id,
						fmt_num(npc.health),
						tostring(requested_state)
					)

					last_mapping[id] = nil
				end
			end

			state_name = resolved_state
		end

		return base_state_mgr_set_state(npc, state_name, callback, timeout, target, extra)
	end

	hook_installed = true
end

function npc_on_death_callback(npc)
	if npc then
		last_mapping[npc:id()] = nil
	end
end

function on_level_changing()
	last_mapping = {}
end

function on_game_start()
	install_state_mgr_hook()

	RegisterScriptCallback("npc_on_death_callback", npc_on_death_callback)
	RegisterScriptCallback("on_level_changing", on_level_changing)

	debug_print(
		"STATE SAFETY TEST loaded threshold=[%s] remap=[raid/sneak, assault/sneak_run] fire_states=[UNCHANGED]",
		fmt_num(HEALTH_THRESHOLD)
	)
end
