-- Visual Memory Manager exports
-- by Alundaio

-- called from engine
-- This occurs during the visible check. If value >= visiblity_threshold then object is considered visible
-- warning npc and who can be nil sometimes
-------------------------------
local db = db
local level = level
local game = game
local math = math
-------------------------------
local jacket_t = {
	["o_medium"] = 2,
	["o_sci"] = 2,
	["o_light"] = 1.35,
	["o_heavy"] = 4.5,
}

local jacketmult = 1
local summ = 0
local renderer = get_console_cmd(0, "renderer")
local is_r1 = (renderer == "renderer_r1")
local correct_game_ver = GAME_VERSION and string.find(GAME_VERSION, "1.5.2") or GAME_VERSION and string.find(GAME_VERSION, "1.5.3")
local campfire_npcs = {}
local muzzle_t = {}
local get_camo_k = 0
local vision_memory = {}
stealth_light_ind = { 0, false }
local ind_t = {}
local marked = {}
local target_marked = 0
last_hit_time = last_hit_time or {}
local weather_ini_cache = {}
local SLOT_FLASHLIGHT = 9
local SLOT_TORCH = 10

function get_visible_value(npc,who,time_delta,time_quant,luminocity,velocity_factor,velocity,distance,object_distance,always_visible_distance)
	distance = distance <= 0 and 0.00001 or distance

	local function obj_is_alive(obj)
		return (IsStalker(obj) or IsMonster(obj)) and obj:alive()
	end

	local npc_fits = npc and obj_is_alive(npc)
	local who_fits = who and obj_is_alive(who)
	if not (npc_fits and who_fits) then
		local def_lum = luminocity <= 0 and 0.0001 or luminocity
		local def_step_incr = time_delta / time_quant * def_lum * (1 + velocity_factor * velocity) * (distance - object_distance) / distance
		return def_step_incr
	end

	-- mcm configs
	stealth_cfg = stealth_mcm.get_config
	cfg_lum  = stealth_cfg("luminocity")
	cfg_vel  = stealth_cfg("velocity")
	cfg_dist = stealth_cfg("distance")

	-- luminocity & distance multipliers
	luminocity = get_luminocity_mult(npc, who, luminocity, object_distance, distance)
	local lum_dist   = (distance - object_distance / 1.35) / distance
	local Luminocity = (33 * luminocity * lum_dist) * cfg_lum

	-- velocity, distance, camouflage, weight, crouch
	local Velocity = (1 + velocity_factor * velocity) * cfg_vel
	local eq_dist  = ((distance - object_distance / 1.15) / distance) * cfg_dist
	local fog_mult = get_fog_visibility_mult(object_distance)
	local camo_x   = get_camo_mult(velocity, object_distance, who)	-- actor only
	local weight   = get_weight_mult(object_distance, who)		-- actor only
	local crouch   = get_crouch_mult(who)

	-- danger, muzzle, scheme, memory, NVG
	local danger_mult   = get_danger_mult(npc, time_quant)
	local muzzle_flash  = muzzle_t[who:id()] or 0
	local scheme_mult   = get_scheme_mult(npc)
	local memory_factor = get_memory_val(npc, who)
	local nvg_factor    = get_nvg_val(npc)

	--============== total =============================
	local step_incr = (Luminocity * Velocity * eq_dist * camo_x * weight * crouch * danger_mult * scheme_mult + muzzle_flash + memory_factor + nvg_factor + target_marked) * fog_mult
	------------------------------------------------------------------------
	-- debug & icons
	stealth_icon_alt(npc, who, step_incr)
	stealth_dbg(npc, who, step_incr, Luminocity, luminocity, Velocity, distance, weight, crouch, lean, danger_mult, camo_x, scheme_mult, memory_factor, eq_dist, nvg_factor, fog_mult, target_marked, fog_mult)
	------------------------------------------------------------------------

	return step_incr
end

--------------------------------------------------------------------------------
------- Luminocity

-- main
function lights_lum()
	local function andruxa(animegif)
		return 0.21 * animegif.x + 0.72 * animegif.y + 0.07 * animegif.z
	end

	local andsun = andruxa(weather.get_value_vector("sun_color"))
	local andhem = andruxa(weather.get_value_vector("hemisphere_color"))
	local andlum = math.max(andhem, andsun)

	return andlum
end

function get_luminocity_mult(npc, who, luminocity, object_distance, distance)
	local michiko_patch = stealth_mcm.get_config("michiko_patch")
	local hrs = level.get_time_hours() + level.get_time_minutes() / 60
	local who_lum = who:get_luminocity()

	-- dx8
	local lumin_r1 = luminocity <= 0 and 0.0001 or luminocity
	if is_r1 then
		if level_weathers.bLevelUnderground then
			return lumin_r1 + 0.35
		end
		return lumin_r1
	end

	-- colors, time, lum
	local lumin_r2 = (who_lum + who_lum^0.5 + lights_lum()) / 3.02
	local is_night = (hrs >= 21 or hrs < 5)
	local lumin_night = clamp((lumin_r2 * 2)^1.6, 0.01, 0.99)
	if michiko_patch then
		is_night = (hrs > 21 or hrs < 5)
		lumin_night = clamp((lumin_r2 * 7)^3, 0.01, 0.99)
	end

	-- campfire / underground
	lumin_r2 = lumin_r2 + (campfire_npcs[who:id()] or 0)

	if is_night then
		lumin_r2 = lumin_night
	end

	if level_weathers.bLevelUnderground then
		lumin_r2 = lumin_r2 + 0.35
	end

	-- flashlights
	local torch = db.actor:item_in_slot(SLOT_TORCH)
	local flash = db.actor:item_in_slot(SLOT_FLASHLIGHT)
	local npc_torch = IsStalker(npc) and npc:object("device_torch")
	local who_torch = IsStalker(who) and who:object("device_torch")
	local who_dist = 20 / object_distance
	local npc_dist = 10 / object_distance

	local actor_torch_active = (who:id() == db.actor:id()) and ( (torch and torch:torch_enabled()) or (flash and (flash:section() == "device_flashlight") and db.actor:active_detector()) )
	local npc_to_npc_torch_active = who_torch and who_torch:attachable_item_enabled()
	local npc_torch_active = npc_torch and npc_torch:attachable_item_enabled() and (object_distance <= 25 and distance > 90)

	if actor_torch_active or npc_to_npc_torch_active then
		lumin_r2 = lumin_r2 + who_dist
	elseif npc_torch_active then
		lumin_r2 = lumin_r2 + npc_dist
	end

	return lumin_r2
end

-- campfires
local cf_tmr = 0
-- FIX: was a bare global; not called dot-qualified anywhere in the mod. Made
-- local (this and the other 8 functions below all being bare globals is not
-- a cross-file collision by itself, but it's unnecessary global-namespace
-- pollution that risks colliding with anything else in the load order that
-- happens to reuse these fairly generic names).
local function set_campfire_val()
	local tg = time_global()
	if tg < cf_tmr then return end
	cf_tmr = tg + 1000

	empty_table(campfire_npcs)

	for id, binder in pairs(bind_campfire.campfires_all) do
		if (binder and binder.campfire and binder.campfire:is_on()) then
			level.iterate_nearest(binder.object:position(), 7, function(who)
				if (who and (IsStalker(who) or IsMonster(who)) and who.alive and who:alive()) then
					campfire_npcs[who:id()] = 0.4
				end
			end)
		end
	end

end

-- fog
local function get_weather_ini()
	local wm = level_weathers.get_weather_manager()
	local preset = wm:get_curr_weather_preset()
	if weather_ini_cache[preset] then 
		return weather_ini_cache[preset] 
	end

	local path = "environment\\weathers\\" .. preset .. ".ltx"
	local ini = ini_file(path)
	if ini then weather_ini_cache[preset] = ini end
	return ini
end

local function get_weather_section()
	local hrs = level.get_time_hours()
	return string.format("%02d:00:00", hrs)
end

local function get_fog_params()
	local ini = get_weather_ini()
	if not ini then return 1.0, 250 end

	local section = get_weather_section()
	if not ini:section_exist(section) then
		return 1.0, 250
	end

	local fog_dens = ini:r_float(section, "fog_density")
	local fog_dist = ini:r_float(section, "fog_distance")
	fog_dens = fog_dens or 1.0
	fog_dist = fog_dist or 250

	return fog_dens, fog_dist
end

function get_fog_visibility_mult(object_distance)
	local fog_dens, fog_dist = get_fog_params()
	if not fog_dens or not fog_dist then return 1 end

	local fog_range = fog_dist * 0.1
	local denom = math.max(0.001, (fog_dist - fog_range))
	local d = math.max(0, (object_distance - fog_range) / denom)
	d = math.min(d, 1)

	local fog_strength = math.min(1, fog_dens * 8.5)
	local fog_mult = 0.35 + (1 - fog_strength) * (1 - d^1.2)

	return fog_mult
end

-- icon
function icon_lum()
	local act_lum = db.actor:get_luminocity()
	local dblum = (act_lum + act_lum^0.5 + lights_lum()) / 3 + (campfire_npcs[AC_ID] or 0)
	local luminocity_icon = is_r1 and (act_lum)^0.7 or dblum

	return luminocity_icon
end

-- alt icon
function stealth_icon_alt(npc, who, incr)
	if who:id() ~= db.actor:id() then return end

	local is_enemy_to_ac = game_relations.get_npcs_relation(npc, who) == game_object.enemy
	if not (is_enemy_to_ac) then return end

	local in_danger = (db.storage[npc:id()] and db.storage[npc:id()].danger_flag) or (npc:best_enemy() and true) or false
	local vis_t = npc:visibility_threshold()
	ind_t[npc:id()] = ind_t[npc:id()] or {}
	ind_t[npc:id()].val = ind_t[npc:id()].val or 0
	ind_t[npc:id()].norm = ind_t[npc:id()].norm or false
	ind_t[npc:id()].danger = in_danger

	if (npc:see(who)) then
		ind_t[npc:id()].val = 1
	else
		incr = normalize(incr, 0, vis_t)
		if not (ind_t[npc:id()].norm) then
			ind_t[npc:id()].val = normalize(ind_t[npc:id()].val, 0, vis_t)
			ind_t[npc:id()].norm = true
		end
		ind_t[npc:id()].val = (ind_t[npc:id()].val < 1) and ind_t[npc:id()].val + incr or 1
	end

	local function del_elem(te_id)
		ind_t[te_id] = nil
		return true
	end
	ResetTimeEvent("stealth_hud_e" .. npc:id(), "stealth_hud_a" .. npc:id(), 1)
	CreateTimeEvent("stealth_hud_e" .. npc:id(), "stealth_hud_a" .. npc:id(), 1, del_elem, npc:id())
end

-- FIX: was a bare global; not called dot-qualified anywhere. Made local.
local function update_icon()
	local max_id = next(ind_t)
	local max_val = ind_t[max_id] and ind_t[max_id].val or 0

	for id, t in pairs(ind_t) do
		if t.val > max_val then
			max_id, max_val = id, t.val
		end
	end

	stealth_light_ind[1] = max_val
	stealth_light_ind[2] = ind_t[max_id] and ind_t[max_id].danger or false
end

--------------------------------------------------------------------------------
------- Camo and weight

-- FIX: was a bare global; not called dot-qualified anywhere. Made local, and
-- MOVED ahead of actor_on_first_update below (which calls it internally, bare -
-- Lua locals are not hoisted, so slot_in_out needs to already be in scope at
-- the point actor_on_first_update's body is defined).
local function slot_in_out(obj)
	if not IsOutfit(obj) then return end
	local outfit = db.actor:item_in_slot(7)
	local kind = outfit and ini_sys:r_string_ex(outfit:section(),"kind")
	local get_camo_get_line = outfit and ini_sys:line_exist(outfit:section(), "npc_blindness_koeff")
	get_camo_k = get_camo_get_line and ini_sys:r_float(outfit:section(), "npc_blindness_koeff") or 0

	jacketmult = kind and jacket_t[kind] or 1
end

-- FIX: was a bare global, colliding with the identically-named
-- actor_on_first_update in redone_ai_aim_settings.script, redone_npc_fleeing.script
-- and stealth_nvg.script - only whichever file loaded last would ever actually
-- run. Made local (moved here, after slot_in_out, which it calls internally).
local function actor_on_first_update()
	local outfit = db.actor:item_in_slot(7)
	if not (outfit) then return end

	for i = 1, 13 do
		local obj = db.actor:item_in_slot(i)
		slot_in_out(obj)
	end
end

function get_camo_mult(velocity, object_distance, who)
	local camo_mult = 1
	local camo_checks = get_camo_k > 0 and velocity == 0 and object_distance >= 30

	if (who:id() ~= AC_ID) or (not camo_checks) then
		return camo_mult
	end

	local camo_dist = 1 - object_distance * 0.01
	local camo_mult = get_camo_k / 20 * camo_dist
	camo_mult = clamp(camo_mult, 0.02, 1.0)

	return camo_mult
end

function get_weight_mult(object_distance, who)
	if (who:id() ~= AC_ID) then return 1 end

	local actor_weight = db.actor:get_total_weight()
	local weight_factor = math.exp(actor_weight / 100)
	local dist = 1.1 - 0.02 * object_distance
	local weight_mult = weight_factor * jacketmult * dist * stealth_mcm.get_config("weight")
	weight_mult = weight_mult > 1 and weight_mult or 1

	return weight_mult
end

--------------------------------------------------------------------------------
------- Body state / Danger + lean / Scheme / Memory + Combat / Muzzle flash / Marked

-- body state
function get_crouch_mult(who)
	local crouch_mult = 1
	local crouch_state = IsMoveState('mcCrouch') or IsMoveState("mcCrouch")
	local accel_state  = IsMoveState('mcAccel')  or IsMoveState("mcAccel")

	if who:id() == AC_ID then
		if crouch_state then
			crouch_mult = accel_state and stealth_mcm.get_config("low_crouch") or stealth_mcm.get_config("crouch")
		end
	elseif IsStalker(who) and who:body_state() == move.crouch then
		crouch_mult = stealth_mcm.get_config("crouch")
	end

	return crouch_mult
end

-- danger
function get_danger_mult(npc, time_quant)
	local danger_mult = 1

	if IsMonster(npc) then
		danger_mult = 0.003 / time_quant
	elseif IsStalker(npc) then
		danger_mult = 1 + (time_quant * 2)
	end

	local st = db.storage[npc:id()]
	if st and st.danger_flag then
		danger_mult = danger_mult * 2
	end

	-- lean
	local lean_state = IsMoveState('mcLLookout') or IsMoveState('mcRLookout') or IsMoveState("mcLookout")
	if lean_state then
		local actor = db.actor
		if actor then
			local dist = npc:position():distance_to(actor:position())
			local lean_bonus = math.max(1.2, 2.5 - (dist / 40))
			lean_bonus = math.min(2.5, lean_bonus)
			danger_mult = danger_mult * lean_bonus
		end
	end

	return danger_mult
end

-- scheme
function get_scheme_mult(npc)
	local scheme_mult = 1
	local st = db.storage[npc:id()]

	if st and ((st.active_scheme == "guard") or (st.active_scheme == "sniper")) then
		scheme_mult = 0.25
	end

	return scheme_mult
end

-- memory
function get_memory_val(npc, who)
	local tg = time_global()
	local memory_val = 0
	local mcm_memory = stealth_mcm.get_config("memory")

	local who_fits = IsStalker(who) or IsMonster(who)
	if not who_fits then
		return
	end

	local see = npc:see(who)
	local vis_memory_t = vision_memory[npc:id()] and vision_memory[npc:id()][who:id()] or nil
	-- Initialize / update vision memory
	if (see) and (not (vis_memory_t)) then
		vision_memory[npc:id()] = vision_memory[npc:id()] or {}
		vision_memory[npc:id()][who:id()] = true
	elseif (not (see)) and (vis_memory_t) then
		local mem_time = (tg - npc:memory_time(who)) * 0.001
		mem_time = math.max(mem_time, 0.1)

		local mem_time_factor = 7.5 * (1 / mem_time)^2
		local vis_threshold = npc:visibility_threshold()

		memory_val = mcm_memory * mem_time_factor * vis_threshold
		-- 35 threshold:  100 sec = 0.025 ; 80 sec = 0.04 ; 60 sec = 0.08 ; 40 sec = 0.17 ; 20 sec = 0.66 ; 10 sec = 2.6
	end

	-- combat
	local id = npc:id()
	db.storage[id] = db.storage[id] or {}

	local st = db.storage[id]
	local last_hit = st.last_hit_time
	local hit_by = st.hitted_by

	local distance = npc:position():distance_to(who:position()) or 0
	local hit_window = 5000 + math.min(distance, 300) * 50
	local recently_hit = last_hit and (time_global() - last_hit < hit_window) and hit_by == who:id()

	local hrs = level.get_time_hours() + level.get_time_minutes() / 60
	local is_night = (hrs >= 21 or hrs < 5)

	local torch = db.actor:item_in_slot(10)
	local flash = db.actor:item_in_slot(9)
	local who_has_torch =
		(torch and torch:torch_enabled())
		or (flash and flash:section() == "device_flashlight" and db.actor:active_detector())

	local wpn = nil
	if who and who:alive() then
		local is_actor = (db.actor and who:id() == db.actor:id())
		if IsStalker(who) or is_actor then
			wpn = who:active_item()
		end
	end

	local dist = npc:position():distance_to_sqr(who:position())
	local close_combat = dist < 100
	if close_combat then target_marked = 50000
	elseif marked[npc:id()] == who:id() then
		if (is_night) then
			if (see) then
				target_marked = 50000
			elseif (recently_hit) then
				target_marked = 15000 + math.min(distance * 10, 10000)
				db.storage[npc:id()].last_known_target_pos = who:position()
			elseif (who_has_torch) then
				target_marked = 50000
			elseif (not see) then
				target_marked = 0
			else
				local mf_val = math.floor(memory_val * 1000)
				if (wpn and wpn:weapon_is_silencer()) then
					mf_val = mf_val + 15000
				else
					mf_val = mf_val + 50000
				end

				mf_val = math.max(0, mf_val - math.floor(distance * 0.5))
				target_marked = math.min(50000, mf_val)
			end

		else
			if (see) then
				target_marked = 50000
			elseif (recently_hit) then
				target_marked = 25000 + math.min(distance * 10, 10000)
				db.storage[npc:id()].last_known_target_pos = who:position()
			elseif (not see) then
				target_marked = 0
			else
				if (wpn and wpn:weapon_is_silencer()) then
					mf_val = mf_val + 25000
				else
					mf_val = mf_val + 50000
				end

				target_marked = math.min(50000, target_marked)
			end
		end
	else
		target_marked = 0
	end

	memory_val = (memory_val > 0.01) and memory_val or 0

	if st and st.danger_flag then
		memory_val = memory_val * 1.5
	end

	return memory_val
end

-- nvg
function get_nvg_val(npc)
	local nvg_val = stealth_mcm.get_config("nvg_val")
	local hrs = level.get_time_hours() + level.get_time_minutes() / 60
	local is_night = (hrs >= 21 or hrs < 5)

	if not (nvg_val > 0 and is_night and stealth_nvg.stealth_nvg_ps[npc:id()]) then
		return 0
	end

	return nvg_val
end

-- muzzle flash
if correct_game_ver then
	AddScriptCallback("npc_on_weapon_fired")
	function xr_motivator.motivator_binder:weapon_fired()
		SendScriptCallback("npc_on_weapon_fired", self.object, self.object:active_item())
	end
end

-- FIX: was a bare global; not called dot-qualified anywhere. Made local.
local function actor_on_weapon_fired()
	local wpn = db.actor:active_item()
	if not (wpn) then return end
	if not (IsWeapon(wpn)) or IsMelee(wpn) then return end

	local actor_id = db.actor:id()
	local muzzle_power = wpn:weapon_is_silencer() and 3 or 7
	muzzle_t[actor_id] = muzzle_power

	local function wpn_fired_stop(id)
		muzzle_t[id] = 0
		return true
	end

	CreateTimeEvent(
		"stealth_wpn_fired_e_" .. actor_id,
		"stealth_wpn_fired_a_" .. actor_id,
		0.2,
		wpn_fired_stop,
		actor_id
	)
end

-- FIX: was a bare global, colliding with the identically-named npc_on_net_spawn
-- in stealth_nvg.script - only whichever file loaded last would ever actually
-- run. Made local.
local function npc_on_net_spawn(npc)
	if not (npc and IsStalker(npc) and npc.alive and npc:alive()) then return end
	local binder = npc.binded_object and npc:binded_object()
	if not binder then return end
	npc:set_callback(callback.weapon_fired, binder.weapon_fired, binder)
end

-- FIX: was a bare global; not called dot-qualified anywhere. Made local.
local function npc_on_weapon_fired(npc, wpn)
	if not (wpn) then return end
	if not (IsWeapon(wpn)) or IsMelee(wpn) then return end
	if not (npc and IsStalker(npc) and npc.alive and npc:alive()) then return end

	local npc_id = npc:id()
	local muzzle_power = wpn:weapon_is_silencer() and 3 or 7
	muzzle_t[npc_id] = muzzle_power

	local function wpn_fired_stop(id)
		muzzle_t[id] = 0
		return true
	end

	CreateTimeEvent(
		"stealth_wpn_fired_e_" .. npc_id,
		"stealth_wpn_fired_a_" .. npc_id,
		0.2,
		wpn_fired_stop,
		npc_id
	)
end

-- target
-- FIX: was a bare global, colliding with the identically-named npc_on_before_hit
-- in redone_npc_fleeing.script - only whichever file loaded last would ever
-- actually run. Made local.
local function npc_on_before_hit(npc,shit,bone_id,flags)
	if stealth_mcm.get_config("debugx") then
		printf("HIT FROM: %s | id: %s | actor: %s",
		shit.draftsman and shit.draftsman:name() or "nil",
		shit.draftsman and shit.draftsman:id() or -1,
		(shit.draftsman and shit.draftsman:id() == db.actor:id()) and "ACTOR" or "NPC")
	end

	if (IsStalker(shit.draftsman) or shit.draftsman:id() == db.actor:id()) then
		marked[npc:id()] = marked[npc:id()] or true

		local squad = get_object_squad(npc)
		if squad and squad.commander_id then
			for m in squad:squad_members() do
				local member = level.object_by_id(m.id)
				if member and member:alive() then
					marked[member:id()] = marked[member:id()] or true
				end
			end
		end
	end
end

--------------------------------------------------------------------------------
------- Debug

function stealth_dbg(npc, who, step_incr, Luminocity, luminocity, Velocity, distance, weight, crouch, danger_mult, camo_x, scheme_mult, memory_factor, eq_dist, nvg_factor)
	if not (stealth_mcm.get_config("debugx")) then return end

	local wthrs = level_weathers.get_weather_manager():get_curr_weather_preset()
	local obj = level.get_target_obj()

	local obj_fits = obj and (IsStalker(obj) or IsMonster(obj)) and obj.alive and obj:alive()

	if obj_fits then
		if (npc and npc:id() == obj:id()) and (who and who:id() == 0) and (not obj:see(db.actor)) then
			summ = summ + step_incr
		elseif obj:see(db.actor) then
			summ = 0
			news_manager.send_tip(db.actor, "Spotted", 0, nil, 1000)
		end
	end

	local function r(val)
		return round_idp(val, 2)
	end

	local function pr(var, val, ...)
		if var ~= val then
			printf(..., var)
		end
	end

	if obj_fits and (npc and npc:id() == obj:id()) and (who and who:id() == 0) then
		printf('---------------------------------------------------------------')
		printf("Weather is: " .. (wthrs))
		printf("1. Luminocity  ---------- %s", Luminocity)
		printf("1.a) luminocity --------- %s", luminocity)
		printf("1.b) lights_lum() ------- %s", lights_lum())
		printf("1.c) who:get_lum() ---- %s", who:get_luminocity())
		pr(Velocity, 1, ("2. Velocity ------------- %s"))
		printf("3. dist_original --------- %s", distance)
		pr(weight, 1, ("4. weight&outfit ------- %s"))
		pr(crouch, 1, ("5. crouch ------------- %s"))
		pr(muzzle_t[who:id()] or 0, 0, ("6.a) shot_mult --------- %s"))
		pr(danger_mult, 1, ("6.b) danger ------------ %s"))
		pr(camo_x, 1, ("6.c) camo ------------- %s"))
		pr(scheme_mult, 1, ("6.d) ai scheme --------- %s"))
		pr(get_camo_k, 0, ("6.e) get_camo_k ------ %s"))
		pr(jacketmult, 1, ("6.f) jacketmult --------- %s"))
		pr(memory_factor, 0, ("7. memory ------------- %s"))
		pr(nvg_factor, 0, ("8. NVG ------------- %s"))
		printf("8. Step incr --- %s", step_incr)
		actor_menu.set_msg(1, strformat("Threshold: %s/%s || (Lumin: %s | Veloc: %s | Dist: %s | Weight: %s | Memory: %s || Total per update: %s)", r(summ), obj:visibility_threshold(), r(Luminocity), r(Velocity), r(eq_dist), r(weight), r(memory_factor), r(step_incr) ))
	end

	if obj == nil then
		summ = 0
	end
end

-- on_option_change
--============================================================================
-- FIX: was a bare global, colliding with the identically-named on_option_change
-- in 7 other files. Made local.
local function on_option_change()
	stealth_cfg   = stealth_mcm.get_config
	cfg_lum       = stealth_cfg("luminocity")
	cfg_vel       = stealth_cfg("velocity")
	cfg_dist      = stealth_cfg("distance")
	memory        = stealth_mcm.get_config("memory")
	weight        = stealth_mcm.get_config("weight")
	crouch        = stealth_mcm.get_config("crouch")
	low_crouch    = stealth_mcm.get_config("low_crouch")
	nvg_val       = stealth_mcm.get_config("nvg_val")
	michiko_patch = stealth_mcm.get_config("michiko_patch")
	debugx        = stealth_mcm.get_config("debugx")
end

-- on game start
--============================================================================
-- FIX: modules.script's dispatcher now calls visual_memory_manager.on_game_start()
-- (registered via the new LoadScheme(...) line in modules.script). Was a bare
-- global, colliding with the identically-named on_game_start in 12 other files -
-- only whichever file loaded last would ever actually run, meaning none of the
-- 9 RegisterScriptCallback registrations below were guaranteed to fire.
visual_memory_manager = visual_memory_manager or {}
function visual_memory_manager.on_game_start()
	on_option_change()

	RegisterScriptCallback("actor_on_update", set_campfire_val)
	RegisterScriptCallback("actor_on_update", update_icon)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_item_to_slot", slot_in_out)
	RegisterScriptCallback("actor_item_to_ruck", slot_in_out)
	RegisterScriptCallback("actor_on_item_drop", slot_in_out)
	RegisterScriptCallback("actor_on_weapon_fired", actor_on_weapon_fired)
	if correct_game_ver then
		RegisterScriptCallback("npc_on_net_spawn", npc_on_net_spawn)
		RegisterScriptCallback("npc_on_weapon_fired", npc_on_weapon_fired)
		RegisterScriptCallback("npc_on_before_hit", npc_on_before_hit)
	end
end